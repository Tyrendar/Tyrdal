# Copy to .env and change every value marked CHANGE.
POSTGRES_PASSWORD=CHANGE-a-long-random-password
DJANGO_SECRET_KEY=CHANGE-at-least-50-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-first-admin-password
# Host/IP the PDAs and browsers use to reach the server, comma separated.
DJANGO_ALLOWED_HOSTS=*
BACKEND_PORT=8000
# Same barcode within this many ms = scanner double-read (ignored).
CHECK_DEBOUNCE_MS=700
# Port of the admin panel (and API through /api) on the server.
WEB_PORT=80
